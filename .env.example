# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
COLLECTION_NAME=products

# --- Auth: comma-separated API keys; empty = auth disabled (dev only) ---
# In ENVIRONMENT=production the service refuses to start with empty API_KEYS.
API_KEYS=change-me-secret-key

# --- Environment: development | staging | production ---
# production additionally enforces non-empty API_KEYS and defaults logs to JSON
ENVIRONMENT=development

# --- Observability ---
# LOG_FORMAT: text | json (default: text in development, json otherwise)
LOG_FORMAT=
# Prometheus metrics at GET /metrics
METRICS_ENABLED=true
# Sentry error tracking; empty = disabled
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Embedding models (local, FastEmbed/ONNX) ---
# multilingual-e5-large: best multilingual (uk/ru/en) dense model shipped with fastembed 0.8
DENSE_MODEL=intfloat/multilingual-e5-large
DENSE_DIM=1024
SPARSE_MODEL=Qdrant/bm25
SPARSE_LANGUAGE=russian
EMBED_BATCH_SIZE=64
UPSERT_BATCH_SIZE=256

# --- Optional cross-encoder reranking (needs `uv sync --group rerank`) ---
RERANK_ENABLED=false
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TOP_K=50

# --- LLM backend (shared by query understanding + ingest enrichment) ---
# LLM_PROVIDER: ollama (local) | openai (OpenAI or any OpenAI-compatible endpoint)
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
# openai / openai-compatible (vLLM, LiteLLM, Groq, ...): key required when provider=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- LLM query understanding for strict mode (dictionary-free synonyms) ---
# Off: strict mode degrades to per-token heuristics. Any LLM failure also degrades gracefully.
QUERY_LLM_ENABLED=false
# ollama: gemma4:e4b; openai: e.g. gpt-4o-mini
QUERY_LLM_MODEL=gemma4:e4b
QUERY_LLM_TIMEOUT_S=30

# --- LLM product enrichment at ingest (pre-embedding; only products WITHOUT attributes) ---
# Extracts structured attributes, uk/ru/en synonyms, spec summary from the card once per
# product. LLM failure => product is ingested unenriched.
INGEST_LLM_ENABLED=false
INGEST_LLM_MODEL=gemma4:e4b
INGEST_LLM_TIMEOUT_S=60
INGEST_LLM_CONCURRENCY=2
# enrich products that already have supplier attributes too (for uk/ru/en synonyms —
# the main cross-lingual recall lever); false = only attribute-less products
INGEST_ENRICH_WITH_ATTRIBUTES=true

# --- Deployment safety (docker compose) ---
# The Streamlit console (port 8501) has full write/delete power and no auth of its own, so
# it is bound to loopback by default. Reach it via SSH tunnel or an authenticating proxy;
# set UI_BIND=0.0.0.0 only behind a VPN. Mem limits are runaway ceilings, tune per host.
# UI_BIND=127.0.0.1
# API_MEM_LIMIT=6g
# QDRANT_MEM_LIMIT=4g
# UI_MEM_LIMIT=1g

# --- Misc ---
DEBUG=false
# FASTEMBED_CACHE_PATH=/models   # set in docker to persist model downloads
