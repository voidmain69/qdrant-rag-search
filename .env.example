# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
COLLECTION_NAME=products

# --- Auth: comma-separated API keys; empty = auth disabled (dev only) ---
# In ENVIRONMENT=production the service refuses to start with empty API_KEYS.
API_KEYS=change-me-secret-key

# --- Environment: development | staging | production ---
# production additionally enforces non-empty API_KEYS and defaults logs to JSON
ENVIRONMENT=development

# --- Observability ---
# LOG_FORMAT: text | json (default: text in development, json otherwise)
LOG_FORMAT=
# Prometheus metrics at GET /metrics
METRICS_ENABLED=true
# Sentry error tracking; empty = disabled
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Embedding models (local, FastEmbed/ONNX) ---
# multilingual-e5-large: best multilingual (uk/ru/en) dense model shipped with fastembed 0.8
DENSE_MODEL=intfloat/multilingual-e5-large
DENSE_DIM=1024
SPARSE_MODEL=Qdrant/bm25
SPARSE_LANGUAGE=russian
EMBED_BATCH_SIZE=64
UPSERT_BATCH_SIZE=256

# --- Optional cross-encoder reranking (needs `uv sync --group rerank`) ---
RERANK_ENABLED=false
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TOP_K=50

# --- Misc ---
DEBUG=false
# FASTEMBED_CACHE_PATH=/models   # set in docker to persist model downloads
